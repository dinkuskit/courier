{
  "name": "@dinkuskit/courier",
  "version": "0.1.0",
  "description": "Carries news between the plugins installed in one EmDash store",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinkuskit/courier.git"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./store": {
      "types": "./src/store.d.ts",
      "default": "./src/store.js"
    },
    "./doors": {
      "types": "./src/doors.d.ts",
      "default": "./src/doors.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "emdash": ">=1.4.0 <2"
  },
  "devDependencies": {
    "@astrojs/react": "7.0.1",
    "@emdash-cms/sandbox-workerd": "0.9.7",
    "astro": "7.3.8",
    "emdash": "1.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rolldown": "1.2.19",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.10"
  }
}
